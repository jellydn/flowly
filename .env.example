# Path to the repository the agent may inspect. Relative paths resolve from this project.
REPOSITORY_PATH=../oak

# Any model from https://flueframework.com/models.json can be used.
REPO_ASSISTANT_MODEL=openrouter/qwen/qwen3-coder
OPENROUTER_API_KEY=

# Each list, read, or search (code or docs) call consumes one step. Allowed range: 1-20.
REPO_ASSISTANT_MAX_STEPS=8

# Set to true to log one safe line per tool call (tool name, sanitized input,
# status, result count, and budget). Disabled by default.
REPO_ASSISTANT_DEBUG=false

# Reliability: retries, timeouts, and failure injection
# Maximum retry attempts for transient failures (1-10, default 3)
REPO_ASSISTANT_MAX_ATTEMPTS=3
# Initial backoff delay in ms (default 500)
REPO_ASSISTANT_INITIAL_DELAY_MS=500
# Maximum backoff delay in ms (default 5000)
REPO_ASSISTANT_MAX_DELAY_MS=5000
# Per-operation timeout in ms (default 15000)
REPO_ASSISTANT_TIMEOUT_MS=15000

# Failure injection (for demos and testing only — do not enable in production)
# FAIL_FIRST_N_REQUESTS=2
# SIMULATE_TOOL_TIMEOUT=true
# SIMULATE_MALFORMED_RESPONSE=true
# FAIL_OPERATION=search_code

# ---------------------------------------------------------------------------
# PR Review agent (agents/pr-reviewer.ts, npm run review-pr)
# ---------------------------------------------------------------------------
# Required when running as a GitHub Actions review workflow:
#   GITHUB_TOKEN       – secrets.GITHUB_TOKEN (set by the workflow)
#   GITHUB_REPOSITORY  – owner/repo (set automatically by GitHub Actions)
#   PR_NUMBER          – pull-request number
#   BASE_SHA           – base commit SHA
#   HEAD_SHA           – head commit SHA
#   REPOSITORY_PATH    – checkout root (defaults to the current directory)
#
# File-aware review limits (defaults shown):
# PR_REVIEW_MAX_FILES=30
# PR_REVIEW_MAX_DIFF_LINES=4000
# PR_REVIEW_MAX_CONTEXT_READS=20
# PR_REVIEW_MAX_FINDINGS=10

# ---------------------------------------------------------------------------
# GitHub event router (scripts/route-event.ts, npm run route-event)
# ---------------------------------------------------------------------------
# Required when running as a GitHub Actions event-routing step:
#   GITHUB_EVENT_NAME  – set automatically by GitHub Actions
#   GITHUB_EVENT_PATH  – path to the event payload JSON (set by Actions)
#
# Optional:
# EVENT_ROUTER_CONFIG – path to the route config (default event-router.config.json)
# EVENT_ROUTER_STORE  – file path for duplicate-delivery persistence (optional)
# EVENT_ROUTER_DEBUG  – true to emit structured decision logs
