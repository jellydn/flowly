# Path to the repository the agent may inspect. Relative paths resolve from this project.
REPOSITORY_PATH=../oak

# Any model from https://flueframework.com/models.json can be used.
REPO_ASSISTANT_MODEL=openrouter/qwen/qwen3-coder
OPENROUTER_API_KEY=

# Each list, read, or search (code or docs) call consumes one step. Allowed range: 1-20.
REPO_ASSISTANT_MAX_STEPS=8

# Set to true to log one safe line per tool call (tool name, sanitized input,
# status, result count, and budget). Disabled by default.
REPO_ASSISTANT_DEBUG=false

# When true, search_code and search_docs fall back to a direct read_file of
# the path given in the search input on transient search failure. Disabled by
# default; results carry a fallbackUsed flag when the fallback runs.
REPO_ASSISTANT_SEARCH_FALLBACK=false

# Reliability: retries, timeouts, and failure injection
# Maximum retry attempts for transient failures (1-10, default 3)
REPO_ASSISTANT_MAX_ATTEMPTS=3
# Initial backoff delay in ms (default 500)
REPO_ASSISTANT_INITIAL_DELAY_MS=500
# Maximum backoff delay in ms (default 5000)
REPO_ASSISTANT_MAX_DELAY_MS=5000
# Per-operation timeout in ms (default 15000)
REPO_ASSISTANT_TIMEOUT_MS=15000

# Failure injection (for demos and testing only — do not enable in production)
# FAIL_FIRST_N_REQUESTS=2
# SIMULATE_TOOL_TIMEOUT=true
# SIMULATE_MALFORMED_RESPONSE=true
# FAIL_OPERATION=search_code

# ---------------------------------------------------------------------------
# PR Review agent (agents/pr-reviewer.ts, npm run review-pr)
# ---------------------------------------------------------------------------
# Required when running as a GitHub Actions review workflow:
#   GITHUB_TOKEN       – secrets.GITHUB_TOKEN (set by the workflow)
#   GITHUB_REPOSITORY  – owner/repo (set automatically by GitHub Actions)
#   PR_NUMBER          – pull-request number
#   BASE_SHA           – base commit SHA
#   HEAD_SHA           – head commit SHA
#   REPOSITORY_PATH    – checkout root (defaults to the current directory)
#
# File-aware review limits (defaults shown):
# PR_REVIEW_MAX_FILES=30
# PR_REVIEW_MAX_DIFF_LINES=4000
# PR_REVIEW_MAX_CONTEXT_READS=20
# PR_REVIEW_MAX_FINDINGS=10
# Specialist and advisor validation (defaults shown):
# PR_REVIEW_SPECIALISTS=correctness,security,testing,architecture
# PR_REVIEW_SPECIALIST_TIMEOUT_MS=30000
# PR_REVIEW_ADVISOR_ENABLED=false
# PR_REVIEW_ADVISOR_MODEL=openrouter/cohere/north-mini-code:free
# PR_REVIEW_ADVISOR_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# GitHub event router (scripts/route-event.ts, npm run route-event)
# ---------------------------------------------------------------------------
# Required when running as a GitHub Actions event-routing step:
#   GITHUB_EVENT_NAME  – set automatically by GitHub Actions
#   GITHUB_EVENT_PATH  – path to the event payload JSON (set by Actions)
#
# Optional:
# EVENT_ROUTER_CONFIG – path to the route config (default event-router.config.json)
# EVENT_ROUTER_STORE  – file path for duplicate-delivery persistence (optional)
# EVENT_ROUTER_DEBUG  – true to emit structured decision logs

# ---------------------------------------------------------------------------
# Autonomous software factory (scripts/run-factory.ts, npm run run-factory)
# ---------------------------------------------------------------------------
# FACTORY_MODEL=openrouter/cohere/north-mini-code:free
# FACTORY_WORKSPACE_ROOT=/tmp/flowly-factory
# FACTORY_WORKSPACE_STORE=/tmp/flowly-factory/.lifecycle # persisted workspace identity and GC state
# FACTORY_RUN_STORE=.factory-runs # local development only; Actions uses issue comments
# FACTORY_AUTONOMY_POLICY=factory-autonomy.example.json
# FACTORY_CAPABILITY_POLICY=factory-capability.example.json # optional restrict-only overlay; built-in profiles are the default maximum
# FACTORY_CONFIRM_BOUNDARY=implementation # or publication; applies to one run only
# FLOWLY_LEARNING_POLICY=repository-learning.example.json
# FLOWLY_MEMORY_ISSUE=123 # trusted bot-authored GitHub state comment
# FLOWLY_MEMORY_STORE=.flowly/repository-instincts.json # local development only

# ---------------------------------------------------------------------------
# Model evaluation benchmark (scripts/flowly-eval.ts, npm run eval)
# ---------------------------------------------------------------------------
# FLOWLY_EVAL_RESULTS_DIR – results directory (default eval/results)
# FLOWLY_EVAL_API_KEY – fallback key for live OpenAI-compatible calls
# FLOWLY_EVAL_BASE_URL – fallback endpoint for providers not in the registry
#
# Live runs resolve each model's provider, key env, and base URL from the
# config's `models[]` entries (fields: provider, apiKeyEnv, baseUrl). Default
# key envs per provider live in eval/framework/providers.ts (e.g.
# OPENROUTER_API_KEY, ANTHROPIC_API_KEY, DEEPSEEK_API_KEY). FLUE_EVAL_API_KEY
# and FLUE_EVAL_BASE_URL remain legacy fallbacks. FLUE_EVAL_MODEL is retired;
# model ids and providers come from the config.
# Per-model apiKeyEnv/baseUrl overrides require --trust-model-overrides after
# the operator reviews the config. Prefer provider defaults or FLOWLY_EVAL_*.
#
# Scoring: the keyword judge is the default. Pass --judge-model <spec> to
# score with an LLM judge through the same provider seam, e.g.
#   npm run eval -- run --live --judge-model openrouter/qwen/qwen3-coder
#
# Deterministic mode needs no key: `npm run eval -- run` runs the bundled
# capstone suite with built-in deciders and is fully reproducible.
