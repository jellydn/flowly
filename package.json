{
  "name": "flowly",
  "version": "0.1.0",
  "description": "AI-native engineering assistant for modern development.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run check:eval && npm run build && npm run check:docs",
    "check:eval": "tsx scripts/flowly-eval.ts gate eval/suites/sample.json --no-save",
    "check:docs": "tsx scripts/check-doc-tree.ts",
    "start": "flue run agents/repo-assistant.ts",
    "review-pr": "node --import tsx scripts/review-pr.ts",
    "run-factory": "node --import tsx scripts/run-factory.ts",
    "factory": "tsx scripts/factory.ts",
    "memory": "tsx scripts/memory.ts",
    "route-event": "node --import tsx scripts/route-event.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "eval:repository": "tsx eval/repository/scenarios.ts",
    "demo:repository": "tsx demo/repository-analysis.ts",
    "demo:factory": "tsx demo/factory-controls.ts",
    "demo:end-to-end": "tsx demo/end-to-end.ts",
    "capstone:eval": "npm run eval:repository --",
    "capstone:demo": "npm run demo:end-to-end --",
    "eval": "tsx scripts/flowly-eval.ts"
  },
  "dependencies": {
    "@flue/runtime": "^2.0.0",
    "just-bash": "^3.1.0",
    "valibot": "^1.1.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.0",
    "@flue/vite": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
