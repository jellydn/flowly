{
  "name": "flue-repo-assistant",
  "version": "0.1.0",
  "description": "A bounded, read-only repository analysis agent built with Flue.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "flue run agents/repo-assistant.ts",
    "review-pr": "node --import tsx scripts/review-pr.ts",
    "route-event": "node --import tsx scripts/route-event.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc",
    "capstone:eval": "tsx eval/capstone-eval.ts",
    "capstone:demo": "tsx demo/capstone-demo.ts",
    "eval": "tsx scripts/flue-eval.ts"
  },
  "dependencies": {
    "@flue/runtime": "^2.0.0",
    "just-bash": "^3.1.0",
    "valibot": "^1.1.0"
  },
  "devDependencies": {
    "@flue/cli": "^2.0.0",
    "@flue/vite": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.0",
    "vite": "^8.2.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
